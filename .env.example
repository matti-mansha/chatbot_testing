# ==============================================================================
# MILA Chatbot Testing Framework — configuration template
# ==============================================================================
#
#   cp .env.example .env    then fill in every value marked  <<< REQUIRED >>>
#
# This file is committed. NEVER put real secrets in it — put them in .env,
# which is gitignored.
#
# Validate your .env before the first run:
#     ./env/bin/python preflight.py
#
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. OpenAI  — drives BOTH the tester bot and the evaluator
# ------------------------------------------------------------------------------
# This is the only recurring cost, and quota exhaustion is the single most
# common cause of a halted pipeline. Set a spend limit in the OpenAI dashboard.

OPENAI_API_KEY=                      # <<< REQUIRED >>> sk-...
OPENAI_MODEL=gpt-5-nano              # <<< REQUIRED >>> no default in code; must be set
OPENAI_TIMEOUT=60                    # seconds per OpenAI call


# ------------------------------------------------------------------------------
# 2. Notion  — the control panel AND the database for this system
# ------------------------------------------------------------------------------
# Create an INTERNAL integration in your own workspace, then explicitly share
# every database and parent page below with it.
#
# !! Sharing is the #1 silent failure. A database that exists but is not shared
# !! with the integration returns 404 object_not_found, and the pipeline will
# !! idle-fail every 10 seconds without crashing. Run preflight.py to catch this.
#
# Getting an ID: open the database/page as a full page, copy the URL. The ID is
# the 32-char hex string before the "?v=" (databases) or at the end (pages).

NOTION_API_KEY=                          # <<< REQUIRED >>> ntn_... / secret_...

TEST_CASES_DB_ID=                        # <<< REQUIRED >>> Test cases DB
TEST_RUNS_DB_ID=                         # <<< REQUIRED >>> Test Runs DB (the trigger)
TEST_CASE_EXECUTIONS_DB_ID=              # <<< REQUIRED >>> Test Case Executions DB
EVALUATION_PAGES_DB_ID=                  # <<< REQUIRED >>> Evaluation Pages DB
CONVERSATIONS_PARENT_PAGE_ID=            # <<< REQUIRED >>> parent PAGE conversations are created under
TEST_CASE_PROMPT_PARENT_PAGE_ID=         # <<< REQUIRED >>> parent PAGE of versioned test-case prompts
EVALUATION_PROMPT_PARENT_PAGE_ID=        # <<< REQUIRED >>> parent PAGE of versioned evaluation prompts

# Notion property NAMES on the Executions DB. Change only if you renamed the
# columns in Notion. Matching is case-insensitive.
EVALUATION_TEXT_PROPERTY=Evaluation JSON
EVALUATION_SCORE_PROPERTY=Evaluation score
EVALUATION_PAGE_LINK_PROPERTY=Evaluation Page Link   # leave blank to skip back-linking

# Status values written back to the Executions DB. These must match the status
# options defined in Notion EXACTLY.
#
# !! "Test Execustion Started" is a TYPO that exists in the live Notion schema.
# !! Do not "fix" it here unless you also rename the option in Notion, or every
# !! failed execution will fail to update.
EXECUTION_SUCCESS_STATUS=Test Executed
EXECUTION_FAILED_STATUS=Test Execustion Started


# ------------------------------------------------------------------------------
# 3. MILA  — the chatbot under test
# ------------------------------------------------------------------------------
# Use a DEDICATED QA account (e.g. qa-bot@yourdomain.com), never a staff login.
# Execution is strictly serial because this single account gives no conversation
# isolation — see the operating constraints in docs/CLIENT_HANDOVER.md §6.

MILA_URL=                            # <<< REQUIRED >>> full URL of the staging chat page
MILA_LOGIN_USER=                     # <<< REQUIRED >>> QA account email
MILA_LOGIN_PASS=                     # <<< REQUIRED >>>
MILA_HTTP_USER=                      # <<< REQUIRED >>> staging site HTTP basic-auth user
MILA_HTTP_PASS=                      # <<< REQUIRED >>> staging site HTTP basic-auth password


# ------------------------------------------------------------------------------
# 4. Internal service wiring — defaults are correct for a single-host install
# ------------------------------------------------------------------------------

TESTER_API_URL=http://localhost:8501            # tester-bot HTTP API (test_bot_headless.py)
TESTER_API_TIMEOUT=120                          # seconds
BRIDGE_SCRIPT=playwright_bridge_bot_headless.py # Playwright bridge entrypoint


# ------------------------------------------------------------------------------
# 5. Pipeline behaviour
# ------------------------------------------------------------------------------

MAX_TURNS=10                         # conversation turns per test case
EXECUTION_CHECK_INTERVAL=10          # seconds between Notion polls (executions)
EVALUATION_CHECK_INTERVAL=10         # seconds between Notion polls (evaluations)
SESSION_TIMEOUT_MINUTES=30           # tester-bot session cleanup
STALE_EVAL_CLAIM_MINUTES=5           # reclaim an evaluation abandoned by a crashed worker

MAX_RETRIES=3                        # retries for a failed turn
RETRY_DELAY=5                        # seconds between turn retries
MAX_TEST_RESTARTS=5                  # restarts of an entire test case
RESTART_DELAY=10                     # seconds before restarting a test case
MAX_MILA_REJECTION_RETRIES=1         # retries when MILA rejects a message


# ------------------------------------------------------------------------------
# 6. Logging & diagnostics
# ------------------------------------------------------------------------------

LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_DIR=logs
DETAILED_TIMING=true                 # per-step timing in logs
ENABLE_SCREENSHOTS=false             # Playwright screenshots — verbose, costs disk


# ------------------------------------------------------------------------------
# 7. Log retention  (log_retention.py — schedule via cron: 0 3 * * *)
# ------------------------------------------------------------------------------
# Without this job the logs grow without bound. The Setaro instance accumulated
# ~850 MB of 404 spam because retention did not cover every log path.

KEEP_LOG_DAYS=14                     # keep service logs uncompressed
GZIP_LOG_DAYS=3                      # gzip service logs older than this
DELETE_LOG_DAYS=30                   # delete service logs older than this
KEEP_DIAG_DAYS=3                     # diagnostics dumps
KEEP_SCREENSHOT_DAYS=3               # Playwright screenshots

# Analytics JSONL is the DURABLE SYSTEM OF RECORD consumed by the analytics
# vendor. Always export before any Notion clean-up. Retain generously.
KEEP_ANALYTICS_DAYS=30
GZIP_ANALYTICS_DAYS=7
